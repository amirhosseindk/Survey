@model IEnumerable<Survey.Application.Dtos.Questionnaires.QuestionnaireDto>

@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Questionnaires</h1>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-primary">
                <tr>
                    <th>Title</th>
                    <th>Course</th>
                    <th>Class</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var questionnaire in Model)
                {
                    <tr>
                        <td>@questionnaire.Title</td>
                        <td>@questionnaire.CourseName</td>
                        <td>@questionnaire.ClassName</td>
                        <td>
                            <a class="btn btn-primary btn-sm" asp-controller="Questionnaire" asp-action="Fill" asp-route-id="@questionnaire.Id">Fill</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>