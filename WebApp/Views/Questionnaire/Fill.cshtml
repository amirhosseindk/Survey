@using WebApp.Extensions
@model Survey.Application.Dtos.Questionnaires.QuestionnaireDto

@{
    ViewData["Title"] = "Fill Questionnaire";
    Layout = null;
    int questionnaireid = ViewBag.QuestionnaireId;
    bool isAnswered = ViewBag.IsAnswered;
    IEnumerable<Survey.Application.Dtos.Answer.AnswerDto> studentAnswers = ViewBag.Answers ?? new List<Survey.Application.Dtos.Answer.AnswerDto>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Questionnaire</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #007bff;
        }

        .question {
            margin-bottom: 20px;
        }

            .question label {
                display: block;
                font-weight: bold;
                margin-bottom: 5px;
            }

            .question input[type="text"],
            .question textarea,
            .question input[type="number"],
            .question input[type="range"] {
                width: 100%;
                padding: 10px;
                border: 1px solid #ced4da;
                border-radius: 4px;
                box-sizing: border-box;
                margin-bottom: 10px;
            }

            .question input[type="radio"] {
                margin-right: 10px;
            }

            .question label.option-label {
                display: block;
                margin-bottom: 5px;
            }

        button[type="submit"] {
            background-color: #007bff;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            display: block;
            width: 100%;
            font-size: 16px;
        }

            button[type="submit"]:hover {
                background-color: #0056b3;
            }
    </style>
</head>
<body>

    <div class="container">
        <h1>Questions</h1>
        <form id="questionnaire-form">
            @foreach (var question in Model.Questions)
            {
                var existingAnswer = studentAnswers.FirstOrDefault(a => a.QuestionId == question.Id);
                <div class="question">
                    <label>@question.Title</label>
                    @switch (question.Type)
                    {
                        case 0: // Text
                            <textarea name="answer-@question.Id">@existingAnswer?.AnswerText</textarea>
                            break;
                        case 1: // Multiple choice
                            int rank = 1;
                            foreach (var option in question.Options)
                            {
                                <label class="option-label">
                                    <input type="radio" name="answer-@question.Id" value="@rank"
                                    @(existingAnswer?.AnswerOptionId == rank ? "checked" : "") /> @option.OptionText
                                </label>
                                rank++;
                            }
                            break;
                        case 2: // Range
                            <input type="range" name="answer-@question.Id" min="0" max="100"
                                   value="@(existingAnswer?.AnswerValue ?? 50)" />
                            break;
                        case 3: // Numeric
                            <input type="number" name="answer-@question.Id" min="0" max="5"
                                   value="@(existingAnswer?.AnswerValue ?? 0)" />
                            break;
                    }
                </div>
            }
            <button type="submit">Submit</button>
        </form>
    </div>

    <script>
        // Assign isAnswered to a JS variable
        const isAnswered = @Json.Serialize(isAnswered);
        const studentId = '@User.GetUserId()'; // Ensure this renders as a string

        document.getElementById('questionnaire-form').addEventListener('submit', function (event) {
            event.preventDefault();

            const formData = new FormData(event.target);
            const createAnswers = [];
            const updateAnswers = [];

            formData.forEach((value, key) => {
                const [prefix, id] = key.split('-');
                if (prefix === 'answer') {
                    const question = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Questions));
                    const q = question.find(q => q.Id.toString() === id);
                    const questionId = parseInt(id);

                    const answer = {
                        questionId: questionId,
                        studentId: studentId,
                        fillDateTime: new Date().toISOString(),
                        type: q.Type
                    };

                    if (q.Type === 0) { // Text answer
                        answer.answerText = value;
                    } else if (q.Type === 1) { // Multiple choice
                        answer.answerOptionId = parseInt(value);
                    } else if (q.Type === 2) { // Range
                        answer.answerValue = parseInt(value);
                    } else if (q.Type === 3) { // Numeric rating
                        answer.answerValue = parseInt(value);
                    }

                    if (isAnswered) {
                        updateAnswers.push(answer);
                    } else {
                        createAnswers.push(answer);
                    }
                }
            });

            const answersToSubmit = {
                createAnswers: createAnswers,
                updateAnswers: updateAnswers.length > 0 ? updateAnswers : null
            };

            fetch(`/Questionnaire/SubmitAnswers/@questionnaireid`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(answersToSubmit)
            }).then(response => {
                if (response.ok) {
                    alert('Responses were successfully recorded.');
                    window.location.href = `/Home/Index`;
                } else {
                    alert('There was an issue recording the responses.');
                }
            });
        });
    </script>

</body>
</html>