@using WebApp.Extensions
@model Survey.Application.Dtos.Questionnaires.QuestionnaireDto

@{
    ViewData["Title"] = "Fill Questionnaire";
    Layout = null;
    int questionnaireid = ViewBag.QuestionnaireId;
    bool isAnswered = ViewBag.IsAnswered;
    IEnumerable<Survey.Application.Dtos.Answer.AnswerDto> studentAnswers = ViewBag.Answers ?? new List<Survey.Application.Dtos.Answer.AnswerDto>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Questionnaire</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <!-- Custom CSS -->
    <style>
        /* CSS Variables */
        :root {
            /* Light Mode Variables */
            --primary-color: #7fcde7;
            --secondary-color: #ffcbc2;
            --background-color: #f5f8fa;
            --text-color: #333;
            --input-border-color: #e0e6ed;
            --shadow-color: rgba(0, 0, 0, 0.1);
            --icon-color: #ffeb3b; /* Icon color for dark mode toggle */
        }

        body.dark-mode {
            /* Dark Mode Variables */
            --primary-color: #1e3e62; /* Dark blue */
            --secondary-color: #282a36; /* Teal */
            --background-color: #0b192c; /* Deep navy */
            --text-color: #ffffff; /* White */
            --input-border-color: #444; /* Darker border */
            --shadow-color: rgba(30, 62, 98, 0.5); /* Dark blue shadow */
            --icon-color: #ffeb3b; /* Icon color for dark mode toggle */
        }

        /* Global Styles */
        body {
            background-color: var(--background-color);
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            font-family: "Roboto", sans-serif;
            color: var(--text-color);
            margin: 0;
            padding: 0;
            min-height: 100vh;
            transition: background-color 0.3s, color 0.3s;
        }

        /* Navbar Styles */
        .navbar {
            background-color: var(--primary-color) !important;
            background: linear-gradient(to right, #4578b3, #ba958e);
            box-shadow: 0 4px 10px var(--shadow-color);
        }

        .navbar-brand, .navbar-nav .nav-link {
            color: #fff !important;
        }

        #toggle-dark-mode i {
            color: var(--icon-color);
            transition: color 0.3s;
        }

        /* Form Styles */
        .form-control,
        .form-range {
            background-color: var(--background-color);
            color: var(--text-color);
            border: 1px solid var(--input-border-color);
            border-radius: 5px;
            box-shadow: 0 2px 4px var(--shadow-color);
        }

        .form-label {
            color: var(--text-color);
        }

        /* Submit Button Styles */
        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            padding: 12px 25px;
            font-size: 18px;
            border-radius: 25px;
            box-shadow: 0 4px 6px var(--shadow-color);
            transition: background-color 0.3s ease;
        }

            .btn-primary:hover {
                background-color: #66b6d5;
            }

        /* Improved Radio Button Styles */
        .form-check-input[type="radio"] {
            accent-color: var(--primary-color);
            width: 1.2em;
            height: 1.2em;
            background-color: #e0e0e0;
            border: 1px solid #aaa;
            transition: background-color 0.3s, border-color 0.3s;
        }

            .form-check-input[type="radio"]:checked {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
            }

            .form-check-input[type="radio"]:hover {
                border-color: #666;
            }

        /* Container and Additional Styles */
        .container {
            max-width: 600px;
            background-color: #fff;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px var(--shadow-color);
        }

        body.dark-mode .container {
            background-color: #070f2b;
        }

        /* Range and Emoji Styles */
        .range-label {
            font-size: 1rem;
            margin-left: 10px;
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-light navbar-expand-lg">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand" href="/Home/Index">Questionnaire Builder</a>
            <!-- Toggler for responsive navbar -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <!-- Home Link -->
                    <li class="nav-item px-3">
                        <a class="nav-link active" href="/Home/Index"><i class="fa fa-home fa-xl" aria-hidden="true"></i></a>
                    </li>
                    <!-- Dark Mode Toggle -->
                    <li class="nav-item px-3">
                        <a class="nav-link" href="#" id="toggle-dark-mode">
                            <i class="fa fa-moon fa-xl" aria-hidden="true" id="dark-mode-icon"></i>
                        </a>
                    </li>
                    <!-- Language Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-language fa-xl" aria-hidden="true"></i>
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="#">Persian</a></li>
                            <li><a class="dropdown-item" href="#">English</a></li>
                        </ul>
                    </li>
                    <!-- User Icon -->
                    <li class="nav-item px-3">
                        <a class="nav-link active" href="#">
                            <i class="fas fa-user-circle fa-xl"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container my-5">
        <h1 class="text-center mb-4 text-primary">Questions</h1>
        <form id="questionnaire-form">
            @foreach (var question in Model.Questions)
            {
                var existingAnswer = studentAnswers.FirstOrDefault(a => a.QuestionId == question.Id);
                <div class="question mb-4">
                    <label class="form-label">@question.Title</label>
                    @switch (question.Type)
                    {
                        case 0: // Text
                            <textarea class="form-control" name="answer-@question.Id">@existingAnswer?.AnswerText</textarea>
                            break;
                        case 1: // Multiple choice
                            int rank = 1;
                            foreach (var option in question.Options)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="answer-@question.Id" value="@rank" @(existingAnswer?.AnswerOptionId == rank ? "checked" : "") />
                                    <label class="form-check-label">@option.OptionText</label>
                                </div>
                                rank++;
                            }
                            break;
                        case 2: // Range
                            <div class="d-flex align-items-center">
                                <input type="range" class="form-range" name="answer-@question.Id" min="0" max="100" value="@(existingAnswer?.AnswerValue ?? 50)" id="answer-@question.Id" />
                                <span id="satisfaction-emoji-@question.Id" class="fs-2 ms-3">
                                    @((existingAnswer?.AnswerValue ?? 50) switch
                                    {
                                        < 20 => "😞",
                                        < 40 => "😕",
                                        < 60 => "😐",
                                        < 80 => "🙂",
                                        _ => "😁"
                                    })
                                </span>
                                <span class="range-label" id="range-value-@question.Id">@((existingAnswer?.AnswerValue ?? 50).ToString())</span>
                            </div>
                            break;
                        case 3: // Numeric
                            <input type="number" class="form-control" name="answer-@question.Id" min="0" max="5" value="@(existingAnswer?.AnswerValue ?? 0)" />
                            break;
                    }
                </div>
            }
            <div class="text-center">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom Script -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Dark Mode Toggle
            document.getElementById("toggle-dark-mode").addEventListener("click", function () {
                document.body.classList.toggle("dark-mode");
                const icon = document.getElementById("dark-mode-icon");
                if (document.body.classList.contains("dark-mode")) {
                    icon.classList.remove("fa-moon");
                    icon.classList.add("fa-sun");
                } else {
                    icon.classList.remove("fa-sun");
                    icon.classList.add("fa-moon");
                }
            });

            // Emoji and Range Value Update for Slider
            document.querySelectorAll('.form-range').forEach(function (slider) {
                const emojiSpan = document.getElementById(`satisfaction-emoji-${slider.id.split('-')[1]}`);
                const rangeValueSpan = document.getElementById(`range-value-${slider.id.split('-')[1]}`);

                slider.addEventListener('input', function () {
                    const value = slider.value;
                    rangeValueSpan.textContent = value;
                    let emoji = '😐';
                    if (value < 20) emoji = '😞';
                    else if (value < 40) emoji = '😕';
                    else if (value < 60) emoji = '😐';
                    else if (value < 80) emoji = '🙂';
                    else emoji = '😁';
                    emojiSpan.textContent = emoji;
                });
            });
        });
            // Assign Razor variables to JavaScript variables
            const isAnswered = @Json.Serialize(isAnswered);
        const studentId = '@User.GetUserId()';
        const questions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Questions));

        // Form Submission Handling
        document.getElementById('questionnaire-form').addEventListener('submit', function (event) {
            event.preventDefault();

            const formData = new FormData(event.target);
            const createAnswers = [];
            const updateAnswers = [];

            formData.forEach((value, key) => {
                const [prefix, id] = key.split('-');
                if (prefix === 'answer') {
                    const questionId = parseInt(id);
                    const question = questions.find(q => q.Id === questionId);

                    const answer = {
                        questionId: questionId,
                        studentId: studentId,
                        fillDateTime: new Date().toISOString(),
                        type: question.Type
                    };

                    // Assign appropriate fields based on question type
                    if (question.Type === 0) { // Text answer
                        answer.answerText = value;
                    } else if (question.Type === 1) { // Multiple choice
                        answer.answerOptionId = parseInt(value);
                    } else if (question.Type === 2 || question.Type === 3) { // Range or Numeric
                        answer.answerValue = parseInt(value);
                    }

                    // Push to create or update array based on isAnswered
                    if (isAnswered) {
                        updateAnswers.push(answer);
                    } else {
                        createAnswers.push(answer);
                    }
                }
            });

            const answersToSubmit = {
                createAnswers: createAnswers,
                updateAnswers: updateAnswers.length > 0 ? updateAnswers : null
            };

            // Submit data via fetch
            fetch(`/Questionnaire/SubmitAnswers/${@questionnaireid}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(answersToSubmit)
            }).then(response => {
                if (response.ok) {
                    alert('Responses were successfully recorded.');
                    window.location.href = `/Home/Index`;
                } else {
                    alert('There was an issue recording the responses.');
                }
            });
        });
    </script>
</body>
</html>