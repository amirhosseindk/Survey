@model WebApp.ViewModels.SurveyResultsViewModel

@{
    ViewData["Title"] = "Results";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نتایج پرسشنامه</title>

    <!-- External Stylesheets -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@latest/dist/font-face.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Custom Styles -->
    <style>
        :root {
            --primary-color: #7fcde7;
            --secondary-color: #ffcbc2;
            --background-color: #f5f8fa;
            --text-color: #333;
            --input-border-color: #e0e6ed;
            --shadow-color: rgba(0, 0, 0, 0.1);
            --icon-color: #ffeb3b;
            --button-color: #007bff;
            --excellent-color: #28a745;
            --good-color: #7bc96f;
            --average-color: #ffc107;
            --poor-color: #dc3545;
        }

        body.dark-mode {
            --primary-color: #1e3e62;
            --secondary-color: #282a36;
            --background-color: #0b192c;
            --text-color: #ffffff;
            --input-border-color: #444;
            --shadow-color: rgba(30, 62, 98, 0.5);
            --icon-color: #ffeb3b;
            --button-color: #0056b3;
        }

        body {
            background-color: var(--background-color);
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            font-family: "Vazir", sans-serif;
            color: var(--text-color);
            margin: 0;
            padding-top: 70px;
            min-height: 100vh;
            transition: background-color 0.3s, color 0.3s;
        }

        .navbar {
            background-color: var(--primary-color) !important;
            background: linear-gradient(to right, #4578b3, #ba958e);
            box-shadow: 0 4px 10px var(--shadow-color);
        }

        .navbar-brand, .navbar-nav .nav-link {
            color: #fff !important;
        }

        #toggle-dark-mode i {
            color: var(--icon-color);
            transition: color 0.3s;
        }

        .chart-container {
            position: relative;
            height: 30vh;
            width: 100%;
        }

        .container-results {
            max-width: 800px;
            margin: auto;
            background: var(--background-color);
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px var(--shadow-color);
        }

        h1 {
            color: var(--primary-color);
        }

        .btn-custom {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 4px;
            text-decoration: none;
            margin: 10px 0;
            transition: background-color 0.3s ease;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--button-color);
            padding: 12px 25px;
            font-size: 18px;
            border-radius: 25px;
            box-shadow: 0 4px 6px var(--shadow-color);
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-light navbar-expand-lg fixed-top" dir="ltr">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Questionnaire Builder</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="تغییر ناوبری">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item px-3">
                        <a class="nav-link active" href="/Professor/Index"><i class="fa fa-home fa-xl" aria-hidden="true"></i></a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link" href="#" id="toggle-dark-mode"><i class="fa fa-moon fa-xl" aria-hidden="true" id="dark-mode-icon"></i></a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-language fa-xl" aria-hidden="true"></i>
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="#">Persian</a></li>
                            <li><a class="dropdown-item" href="#">English</a></li>
                        </ul>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link active" href="#">
                            <i class="fas fa-user-circle fa-xl"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content: Survey Results -->
    <div class="container-results mt-5">
        <h1 class="text-center mb-4">نتایج پرسشنامه</h1>

        <!-- Questions and Answers Section -->
        <section class="mb-5">
            <h2>سوالات و پاسخ‌ها:</h2>
            @foreach (var question in Model.Questionnaire.Questions)
            {
                <div class="mb-4">
                    <h3>@question.Title</h3>

                    @if (question.Type == 1 && question.Options != null)
                    {
                        var chartLabels = question.Options.Select(o => o.OptionText).ToArray();
                        var chartData = question.Options.Select(o => Model.MultipleChoiceResults
                        .Where(r => r.QuestionId == question.Id && r.AnswerOption == question.Options.IndexOf(o) + 1)
                        .Select(r => r.Count).FirstOrDefault()).ToArray();

                        <canvas id="chart-@question.Id" data-chart-type="bar" data-labels='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(chartLabels))' data-data='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(chartData))'></canvas>
                    }
                    else if (question.Type == 0)
                    {
                        <div class="text-question">
                            <p>تعداد پاسخ‌دهنده‌ها: @(Model.TextQuestionResults.FirstOrDefault(r => r.QuestionId == question.Id)?.Count ?? 0)</p>
                            <button class="btn btn-link p-0" onclick="toggleAnswers('answers-@question.Id')">مشاهده همه پاسخ‌ها</button>

                            <div id="answers-@question.Id" style="display:none;">
                                <ul class="list-group mt-2">
                                    @foreach (var answer in Model.TextQuestionResults.FirstOrDefault(r => r.QuestionId == question.Id)?.Answers ?? new List<string>())
                                    {
                                        <li class="list-group-item">@answer</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                    else if (question.Type == 2)
                    {
                        var rangeAverage = Model.RangeQuestionResults.FirstOrDefault(r => r.QuestionId == question.Id)?.Average ?? 0;
                        <canvas id="range-chart-@question.Id" data-chart-type="line" data-labels='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new[] { "میانگین بازه‌ای" }))' data-data='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new[] { rangeAverage }))'></canvas>
                    }
                    else if (question.Type == 3)
                    {
                        var degreeAverage = Model.DegreeQuestionResults.FirstOrDefault(r => r.QuestionId == question.Id)?.Average ?? 0;
                        <div>
                            میانگین امتیاز:
                            @{
                                int fullStars = (int)degreeAverage;
                                bool halfStar = degreeAverage - fullStars >= 0.5;

                                for (int i = 0; i < fullStars; i++)
                                {
                                    <i class="fa fa-star text-warning"></i>
                                }
                                if (halfStar)
                                {
                                    <i class="fa fa-star-half-alt text-warning"></i>
                                }
                                for (int i = fullStars + (halfStar ? 1 : 0); i < 5; i++)
                                {
                                    <i class="fa fa-star text-muted"></i>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </section>

        <!-- Respondents Section -->
        <section class="mb-5">
            <h2>پاسخ‌های دانشجویان:</h2>
            @{
                var pieLabels = new[] { "پاسخ‌دهنده", "غیر پاسخ‌دهنده" };
                var pieData = new[] { Model.AnsweredStudents, Model.TotalStudents - Model.AnsweredStudents };
            }
            <div class="chart-container d-flex justify-content-center">
                <canvas id="respondentsChart" data-chart-type="pie" data-labels='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(pieLabels))' data-data='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(pieData))'></canvas>
            </div>
        </section>

        <!-- Action Buttons -->
        <div class="d-flex flex-column align-items-center">
            <a asp-controller="StatisticalAnalysis" asp-action="CompareWithCollegeAverage" asp-route-questionnaireId="@Model.Questionnaire.Id" class="btn btn-primary btn-custom">مقایسه با میانگین کالج</a>
            <a asp-controller="StatisticalAnalysis" asp-action="PerformOneSampleTTest" asp-route-questionnaireId="@Model.Questionnaire.Id" class="btn btn-primary btn-custom">انجام آزمون تی تک نمونه‌ای</a>
        </div>
    </div>

    <!-- External Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/js/all.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("toggle-dark-mode").addEventListener("click", function (e) {
                e.preventDefault();
                document.body.classList.toggle("dark-mode");
                const icon = document.getElementById("dark-mode-icon");
                if (document.body.classList.contains("dark-mode")) {
                    icon.classList.remove("fa-moon");
                    icon.classList.add("fa-sun");
                } else {
                    icon.classList.remove("fa-sun");
                    icon.classList.add("fa-moon");
                }
            });

            document.querySelectorAll('canvas').forEach(function (canvas) {
                const chartType = canvas.dataset.chartType;
                const labels = JSON.parse(canvas.dataset.labels);
                const data = JSON.parse(canvas.dataset.data);

                let backgroundColors = [];
                let borderColor = getCSSVariable('--primary-color');

                if (chartType === 'pie') {
                    const primaryColor = getCSSVariable('--primary-color');
                    const secondaryColor = getCSSVariable('--secondary-color');
                    backgroundColors = [primaryColor, secondaryColor];
                } else if (chartType === 'bar') {
                    backgroundColors = [
                        getCSSVariable('--excellent-color'),
                        getCSSVariable('--good-color'),
                        getCSSVariable('--average-color'),
                        getCSSVariable('--poor-color')
                    ];
                }

                new Chart(canvas, {
                    type: chartType,
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'نتایج نظرسنجی',
                            data: data,
                            backgroundColor: backgroundColors,
                            borderColor: borderColor,
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'top',
                            },
                            title: {
                                display: false
                            }
                        },
                        scales: chartType === 'bar' || chartType === 'line' ? {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    color: 'var(--text-color)'
                                }
                            },
                            x: {
                                ticks: {
                                    color: 'var(--text-color)'
                                }
                            }
                        } : {}
                    }
                });
            });
        });

        function getCSSVariable(variableName) {
            return getComputedStyle(document.documentElement).getPropertyValue(variableName).trim();
        }

        function toggleAnswers(elementId) {
                const answersContainer = document.getElementById(elementId);
                if (answersContainer.style.display === "none") {
                    answersContainer.style.display = "block";
                } else {
                    answersContainer.style.display = "none";
                }
            }

    </script>
</body>
</html>