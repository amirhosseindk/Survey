@using WebApp.Extensions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        :root {
            --primary-color: #7fcde7;
            --secondary-color: #ffcbc2;
            --background-color: #f5f8fa;
            --text-color: #333;
            --button-color: #7fcde7;
            --icon-color: #ffeb3b;
            --shadow-color: rgba(0, 0, 0, 0.1);
        }

        body.dark-mode {
            --primary-color: #1e3e62;
            --secondary-color: #282a36;
            --background-color: #0b192c;
            --text-color: #ffffff;
            --button-color: #ff6500;
            --icon-color: #ffeb3b;
            --shadow-color: rgba(30, 62, 98, 0.5);
        }

        body {
            background-color: var(--background-color);
            font-family: "Roboto", sans-serif;
            color: var(--text-color);
            margin: 0;
            padding: 0;
            transition: background-color 0.3s, color 0.3s;
        }

        .navbar {
            background: linear-gradient(to right, #4578b3, #ba958e);
            box-shadow: 0 4px 10px var(--shadow-color);
        }

        .footer {
            background-color: var(--primary-color);
            color: var(--text-color);
        }

        .footer-icons i {
            color: var(--icon-color);
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">@ViewData["Title"]</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (User.IsLoggedIn())
                    {
                        if (User.IsProfessor())
                        {
                            <li class="nav-item px-3">
                                <a class="nav-link active" asp-area="" asp-controller="Professor" asp-action="Index"><i class="fa fa-home fa-xl"></i></a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item px-3">
                                <a class="nav-link active" asp-area="" asp-controller="Home" asp-action="Index"><i class="fa fa-home fa-xl"></i></a>
                            </li>
                        }
                    }
                    <li class="nav-item px-3">
                        <a class="nav-link" href="#" id="toggle-dark-mode">
                            <i class="fa fa-moon fa-xl" id="dark-mode-icon"></i>
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-language fa-xl"></i>
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="languageDropdown">
                            <li><a class="dropdown-item" href="#">Persian</a></li>
                            <li><a class="dropdown-item" href="#">English</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        @if (User.IsLoggedIn())
                        {
                            <a class="nav-link dropdown-toggle" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle fa-xl"></i>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="profileDropdown">
                                @if (User.IsProfessor())
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Professor" asp-action="Index">Home</a></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                                }
                                <li>
                                    <form method="post" asp-area="" asp-controller="User" asp-action="Logout" class="dropdown-item">
                                        <button type="submit" class="btn btn-link p-0">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        }
                        else
                        {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="User" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="User" asp-action="Register">Register</a>
                        </li>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="text-center footer">
        <div class="container">
            <section class="mt-5">
                <div class="row text-center d-flex justify-content-center pt-5">
                    <div class="col-md-2"><a href="#" class="text-white">About Us</a></div>
                    <div class="col-md-2"><a href="#" class="text-white">Services</a></div>
                    <div class="col-md-2"><a href="#" class="text-white">Help</a></div>
                    <div class="col-md-2"><a href="#" class="text-white">FAQ</a></div>
                    <div class="col-md-2"><a href="#" class="text-white">Contact</a></div>
                </div>
            </section>
            <hr />
            <section class="mb-5 footer-icons">
                <a href="#" class="me-4"><i class="fa fa-facebook-official" style="font-size:30px"></i></a>
                <a href="#" class="me-4"><i class="fa fa-twitter-square" style="font-size:30px"></i></a>
                <a href="#" class="me-4"><i class="fa fa-whatsapp" style="font-size:30px"></i></a>
                <a href="#" class="me-4"><i class="fa fa-instagram" style="font-size:30px"></i></a>
                <a href="#" class="me-4"><i class="fa fa-linkedin-square" style="font-size:30px"></i></a>
                <a href="#" class="me-4"><i class="fa fa-github-square" style="font-size:30px"></i></a>
            </section>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById("toggle-dark-mode").addEventListener("click", function (e) {
            e.preventDefault();
            document.body.classList.toggle("dark-mode");
            const icon = document.getElementById("dark-mode-icon");
            if (document.body.classList.contains("dark-mode")) {
                icon.classList.remove("fa-moon");
                icon.classList.add("fa-sun");
            } else {
                icon.classList.remove("fa-sun");
                icon.classList.add("fa-moon");
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>