@model IEnumerable<Survey.Application.Dtos.Questionnaires.QuestionnaireDto>

@{
    ViewData["Title"] = "Professor Home";
}

<div class="container mt-5">
    <div class="row">
        <!-- Create Course Section -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Create a Course</h5>
                    <form asp-action="CreateCourse" method="post">
                        <div class="form-group">
                            <label for="courseName">Course Name</label>
                            <input type="text" id="courseName" name="courseName" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Create Course</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Create Class Section -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Create a Class</h5>
                    <a asp-controller="Professor" asp-action="CreateClass" class="btn btn-primary mt-3">Create Class</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Create Questionnaire Section -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Create a Questionnaire</h5>
                    <a asp-controller="Questionnaire" asp-action="Create" class="btn btn-primary mt-3">Create Questionnaire</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Questionnaires List Section -->
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Questionnaires</h5>
                    <form id="questionnaires-form" method="post">
                        <ul class="list-group mb-3">
                            @foreach (var questionnaire in Model)
                            {
                                <li class="list-group-item">
                                    <input type="checkbox" name="questionnaireIds" value="@questionnaire.Id" data-course-id="@questionnaire.CourseId" data-class-id="@questionnaire.ClassId" class="me-2" />
                                    <a asp-controller="Questionnaire" asp-action="Results" asp-route-id="@questionnaire.Id">@questionnaire.Title</a>
                                </li>
                            }
                        </ul>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" formaction="/StatisticalAnalysis/PairedTTest" class="btn btn-primary">Paired T-Test</button>
                            <button type="submit" formaction="/StatisticalAnalysis/CalculateGroupMeans" class="btn btn-primary">Calculate Group Means</button>
                            <button type="submit" formaction="/StatisticalAnalysis/PerformANOVA" class="btn btn-primary">Perform ANOVA</button>
                            <button type="submit" formaction="/StatisticalAnalysis/PerformRepeatedMeasuresANOVA" class="btn btn-primary">Perform Repeated Measures ANOVA</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>