@{
    ViewData["Title"] = "Create Class";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Create a Class</h1>

    <form asp-action="CreateClass" method="post">
        <!-- Class Name Input -->
        <div class="form-group mb-3">
            <label for="className">Class Name</label>
            <input type="text" id="className" name="className" class="form-control" required />
        </div>

        <!-- Course Dropdown -->
        <div class="form-group mb-4">
            <label for="courseId">Select Course</label>
            <select id="courseId" name="courseId" class="form-control" required>
                @foreach (var course in ViewBag.Courses)
                {
                    <option value="@course.Id">@course.Name</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary w-100">Create Class</button>
    </form>
</div>